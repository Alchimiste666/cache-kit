{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!**/dist",
      "!.turbo",
      "!**/.turbo",
      "!*.config.ts",
      "!*.config.js"
    ]
  }
}
