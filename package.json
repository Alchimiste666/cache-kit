{
  "name": "@alchemist-software/cache-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "lint:fix": "biome check --write --unsafe .",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.11",
    "turbo": "^2.10.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "npm@10.8.0",
  "allowScripts": {
    "@swc/core@1.15.47": true
  }
}
